# =============================================================================
# Author : Anil Kalisetti
# File   : .env.example
# Purpose: THE single place to configure the framework.
#          Copy to `.env` (cp .env.example .env) and edit. `.env` is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Profile - which environment to run against
#    offline : no keys, no network. Deterministic mock model, deterministic checks only.
#    local   : free, runs on your machine through Ollama (https://ollama.com).
#    cloud   : hosted providers (OpenAI, Anthropic, ...). Needs the keys below.
# -----------------------------------------------------------------------------
PROFILE=offline

# -----------------------------------------------------------------------------
# 2. Models (used by the local and cloud profiles; ignored by offline)
#    TARGET_PROVIDER    : the model under test.
#    GRADER_PROVIDER    : the model that judges llm-rubric / factuality / etc.
#                         Defaults: local -> same small model, cloud -> TARGET_PROVIDER.
#                         Prefer a stronger, different model than the one under test.
#    EMBEDDING_PROVIDER : used by the `similar` assertion.
#    Provider id formats: https://www.promptfoo.dev/docs/providers/
#    Model names change often - check the provider docs before filling these in.
# -----------------------------------------------------------------------------
# Local defaults (fit an 8 GB RAM laptop):
#   TARGET_PROVIDER=ollama:chat:llama3.2:3b
#   GRADER_PROVIDER=ollama:chat:llama3.2:3b
#   EMBEDDING_PROVIDER=ollama:embeddings:nomic-embed-text
# Cloud examples (replace <model> with a current model name):
#   TARGET_PROVIDER=openai:chat:<model>
#   GRADER_PROVIDER=anthropic:messages:<model>
#   EMBEDDING_PROVIDER=openai:embeddings:text-embedding-3-small
TARGET_PROVIDER=
GRADER_PROVIDER=
EMBEDDING_PROVIDER=

# -----------------------------------------------------------------------------
# 3. API keys / endpoints (leave blank what you do not use)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# 4. Which suites to run: `all` or a comma list of ids from config/suites.js
#    e.g. SUITES=assertions,sensitive-info
# -----------------------------------------------------------------------------
SUITES=all

# -----------------------------------------------------------------------------
# 5. Optional features and run behaviour
# -----------------------------------------------------------------------------
# Python graders need python3 on PATH (or set PROMPTFOO_PYTHON to the interpreter).
ENABLE_PYTHON_GRADERS=false
PROMPTFOO_PYTHON=
MAX_CONCURRENCY=4
# Repeat every test N times (flakiness detection). Combine with NO_CACHE=true.
REPEAT=1
NO_CACHE=false

# -----------------------------------------------------------------------------
# 6. Privacy: results stay local. Telemetry and update checks are switched off.
# -----------------------------------------------------------------------------
PROMPTFOO_CACHE_PATH=./.promptfoo-cache
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_UPDATE=1
